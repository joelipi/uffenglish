VITE_PUBLIC_POSTHOG_KEY=phc_...
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional — Cloudflare R2 poster pipeline (generate-thumbnails --upload)
# If set, `npm run build` + `npm run posters:upload` will push intro posters to R2.
# Otherwise the app still builds; posters are served from dist/ and stale check fails.
# CLOUDFLARE_API_TOKEN=<cf_token>
# CLOUDFLARE_ACCOUNT_ID=<cf_account_id>

# Pages Function env — must match .env values (also set in wrangler.toml [vars]
# and/or Cloudflare Pages dashboard > Settings > Environment variables)
# SUPABASE_URL is set in wrangler.toml; SUPABASE_ANON_KEY should be set in the
# dashboard for /api/upload-segment JWT verification. Both are optional at
# runtime — the Function falls back to the publishable defaults in
# functions/api/upload-segment.js.

# Local Supabase (supabase start) runs on 54321/54322/54323; not required for
# `npm run dev` against the hosted project.

# Cloud lesson-video pipeline (stories/040-modal-lesson-video-pipeline).
# OPERATOR_KEY is the shared operator secret the recorder sends as x-operator-key;
# the three MODAL_* values are the deployed trigger URL and its proxy-token pair.
# Set all four in Cloudflare Pages > Settings > Environment variables — never in
# the static page. Leave them commented here (this file is not loaded by Pages).
# OPERATOR_KEY=<long random>
# MODAL_RENDER_URL=https://<workspace>--trigger.modal.run
# MODAL_PROXY_TOKEN_ID=<proxy token id>
# MODAL_PROXY_TOKEN_SECRET=<proxy token secret>
