node_modules/
# The worktree `node_modules` is a symlink, which the trailing-slash rule above
# does not match; a plain entry stops `git add -A` from tracking it.
node_modules
.wrangler/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
file_last_touched.txt
full_git_log.txt
full_reflog.txt
/.kilo
/.reasonix
/dist
/dist/assets
/dist
/dist
/dist
coverage/
tests/phase2-verify.spec.js
# Lesson media lives on Cloudflare R2 (assets/videos/<slug>.mp4) — never commit local video files
public/assets/videos/*.mp4
/.reasonix
/tidy
/.tokencount
/.reasonix
# .env is local-only (contains sandpod-managed secrets). VITE_PUBLIC_POSTHOG_*
# are optional at build time — posthog-client.js falls back to publishable
# defaults, mirroring the Supabase pattern in src/modules/api/supabase.js.
plans/review-system.md
supabase/.temp/
.env

# Python bytecode
__pycache__/
*.pyc

# Transient config-write temp files (generate-config-from-sheet.mjs writes
# <courseId>.json.tmp-<pid> then renames; a killed run could leave one behind).
src/config/*.tmp-*
